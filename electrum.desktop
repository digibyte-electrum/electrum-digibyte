# If you want Electrum to appear in a Linux app launcher ("start menu"), install this by doing:
# sudo desktop-file-install electrum.desktop
# Note: This assumes $HOME/.local/bin is in your $PATH

[Desktop Entry]
Comment=Electrum DigiByte Wallet
Exec=electrum %u
GenericName[en_US]=DigiByte Wallet
GenericName=DigiByte Wallet
Icon=electrum_digibyte
Name[en_US]=Electrum DigiByte Wallet
Name=Electrum DigiByte Wallet
Categories=Finance;Network;
StartupNotify=true
StartupWMClass=electrum
Terminal=false
Type=Application
MimeType=x-scheme-handler/bitcoin;x-scheme-handler/lightning;x-scheme-handler/lnurlp;x-scheme-handler/lnurlw;
Actions=Testnet;
Keywords=crypto;currency;DigiByte;DGB

[Desktop Action Testnet]
Exec=electrum --testnet %u
Name=Testnet mode
